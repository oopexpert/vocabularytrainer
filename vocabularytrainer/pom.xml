<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>de.oopexpert.oopdi</groupId>
	<artifactId>vocabularytrainer</artifactId>
	<version>0.2.1</version>

	<properties>
		<!-- JDK used for jlink/jpackage; must be a full JDK (not a JRE), override with -Djdk.home=... if needed -->
		<jdk.home>${java.home}</jdk.home>
		<!-- Windows braucht ".exe" bei direkten Prozessaufrufen (kein Shell-PATH-Lookup); auf Linux/macOS leer lassen. Override: -Djdk.bin.suffix=.exe -->
		<jdk.bin.suffix></jdk.bin.suffix>
		<!-- Name der erzeugten Distributions-ZIP; im CI pro Plattform ueberschreiben, z.B. -Ddist.zip.name=VocabularyTrainer-linux-x64.zip -->
		<dist.zip.name>VocabularyTrainer.zip</dist.zip.name>
	</properties>

	<repositories>
		<repository>
			<id>local-repo</id>
			<url>file://${project.basedir}/internal.m2</url>
			<releases>
				<enabled>true</enabled>
			</releases>
		</repository>
	</repositories>

	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.10.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>cglib</groupId>
			<artifactId>cglib</artifactId>
			<version>3.3.0</version>
		</dependency>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>2.11.0</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-csv</artifactId>
			<version>1.12.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<release>21</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<argLine>
						--add-opens=java.base/java.lang=ALL-UNNAMED
						--add-opens=java.base/java.util=ALL-UNNAMED
					</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.4.2</version>
				<configuration>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
					<archive>
						<manifest>
							<mainClass>de.oopexpert.vocabulary.ui.VocabularyTrainerUI</mainClass>
						</manifest>
					</archive>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Erzeugt eine eigenständige Distribution mit mitgelieferter Java-Laufzeitumgebung
			(jlink-Runtime + jpackage app-image) und packt das Ergebnis als ZIP.
			Aufruf: mvn -Pdistribution clean package
			Ergebnis: dist/VocabularyTrainer/... (entpackt) und dist/VocabularyTrainer.zip
		-->
		<profile>
			<id>distribution</id>
			<build>
				<plugins>
					<!-- dist/ und target/staging bei "clean" mit entfernen -->
					<plugin>
						<artifactId>maven-clean-plugin</artifactId>
						<version>3.3.2</version>
						<configuration>
							<filesets>
								<fileset>
									<directory>${project.basedir}/dist</directory>
									<followSymlinks>false</followSymlinks>
								</fileset>
								<fileset>
									<directory>${project.build.directory}/staging</directory>
								</fileset>
							</filesets>
						</configuration>
					</plugin>

					<!-- Fat-Jar (jar-with-dependencies) ins Staging-Verzeichnis kopieren; Runtime bauen; App-Image erzeugen -->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.1.0</version>
						<executions>
							<!-- Minimale, eigenständige Java-Laufzeitumgebung bauen (nur benötigte Module) -->
							<execution>
								<id>jlink</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${jdk.home}/bin/jlink${jdk.bin.suffix}</executable>
									<arguments>
										<argument>--module-path=${jdk.home}/jmods</argument>
										<argument>--add-modules</argument>
										<argument>java.base,java.desktop,java.logging,jdk.unsupported,jdk.zipfs</argument>
										<argument>--output</argument>
										<argument>${project.build.directory}/vocabularytrainer-runtime</argument>
										<argument>--no-header-files</argument>
										<argument>--no-man-pages</argument>
									</arguments>
								</configuration>
							</execution>
							<!-- App-Image (Ordnerstruktur mit mitgelieferter Laufzeit) erzeugen -->
							<execution>
								<id>jpackage</id>
								<phase>install</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${jdk.home}/bin/jpackage${jdk.bin.suffix}</executable>
									<arguments>
										<argument>--type</argument>
										<argument>app-image</argument>
										<argument>--dest</argument>
										<argument>dist</argument>
										<argument>--name</argument>
										<argument>VocabularyTrainer</argument>
										<argument>--input</argument>
										<argument>${project.build.directory}/staging</argument>
										<argument>--main-jar</argument>
										<argument>vocabularytrainer.jar</argument>
										<argument>--main-class</argument>
										<argument>de.oopexpert.vocabulary.ui.VocabularyTrainerUI</argument>
										<argument>--runtime-image</argument>
										<argument>${project.build.directory}/vocabularytrainer-runtime</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>

					<!--
						copy-main-jar-to-staging läuft in der package-Phase (vor jpackage).
						copy-backgrounds-and-zip-dist läuft in der install-Phase NACH jpackage (Plugin-Reihenfolge
						im POM entscheidet bei gleicher Phase über die Ausführungsreihenfolge): optionales lokales
						Hintergrundbilder-Verzeichnis (siehe .gitignore: /backgrounds/) mit hinein kopieren,
						falls vorhanden, und den App-Image-Ordner als ZIP verpacken. BackgroundImages liest
						zur Laufzeit relativ zum Arbeitsverzeichnis aus "backgrounds" - bei jpackage-app-image
						ist das Arbeitsverzeichnis das App-Image-Wurzelverzeichnis.
					-->
					<plugin>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>3.1.0</version>
						<executions>
							<execution>
								<id>copy-main-jar-to-staging</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<copy
											file="${project.build.directory}/${project.build.finalName}-jar-with-dependencies.jar"
											tofile="${project.build.directory}/staging/vocabularytrainer.jar" />
									</target>
								</configuration>
							</execution>
							<execution>
								<id>copy-backgrounds-and-zip-dist</id>
								<phase>install</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<copy todir="${project.basedir}/dist/VocabularyTrainer/backgrounds" failonerror="false">
											<fileset dir="${project.basedir}/backgrounds" erroronmissingdir="false" />
										</copy>
										<zip destfile="${project.basedir}/dist/${dist.zip.name}"
											basedir="${project.basedir}/dist"
											includes="VocabularyTrainer/**" />
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>